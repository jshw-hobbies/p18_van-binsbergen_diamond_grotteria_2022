# Copy this file to `.env` in the repo root and fill in your own values.
# `.env` is gitignored. Keep the values in this file blank: it is committed.
#
# Only secrets and machine-specific paths go here. Parameters such as
# START_DATE and END_DATE are committed constants in src/settings.py, and
# setting one here raises an error.

# Your WRDS username. With a pgpass file (set up in HW1), WRDS connects
# without asking for your password.
WRDS_USERNAME=

# Your Databento API key (databento.com, Account > API keys).
DATABENTO_API_KEY=

# Optional: where pulled data goes. Leave this commented out to use `_data/`
# in the repo. Don't set it to an empty value: that means the repo root.
# DATA_DIR=
